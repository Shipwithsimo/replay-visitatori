# Shopify app credentials (Dev Dashboard > your app > Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Your store, e.g. my-store.myshopify.com (only this store can open the panel)
SHOP_DOMAIN=
# Password to open the panel outside the Shopify admin (optional)
DASHBOARD_PASSWORD=
# Accept recordings only from these origins, comma separated (optional)
# e.g. https://www.mystore.com,https://my-store.myshopify.com
ALLOWED_ORIGINS=
# Days to keep recordings
RETENTION_DAYS=30
# Where the SQLite database lives (mount a persistent volume here)
DATA_DIR=/data
